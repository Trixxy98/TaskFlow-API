PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=taskflow_db

JWT_SECRET=your_super_secret_key_minimum_32_characters
JWT_EXPIRES_IN=15m

# Comma-separated for multiple origins, e.g. production + localhost
ALLOWED_ORIGIN=http://localhost:5173

GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com

# Set to true to allow POST /api/subscription/activate (demo unlock until Stripe)
# Leave false in copied production configs. Unset still enables demo unlock in development.
ALLOW_MANUAL_UPGRADE=false

# Stripe (test keys for local; live keys only in production)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_pro_monthly_price_id
# Shown on Pricing page (must match the Price you created)
STRIPE_PRO_PRICE_LABEL=RM 19/mo

# Optional public app URL for password-reset links (defaults to first ALLOWED_ORIGIN)
APP_URL=http://localhost:5173

# SMTP for forgot-password email (optional in development — reset URL returned in API JSON)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="TaskFlow <noreply@example.com>"
