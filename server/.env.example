# Server
PORT=3001
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=taskflow_db

# JWT
# Access token — pendek supaya selamat (15m = 15 minit)
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=15m

# CORS — URL frontend yang dibenarkan
# Development:  http://localhost:5173
# Production:   https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173
